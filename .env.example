# NexusPanel Environment Configuration
# Copy this file to .env and adjust values

# Server port
PORT=3000

# Node environment (development | production)
NODE_ENV=production

# JWT secret key — CHANGE THIS to a random string!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-random-secret-key

# JWT token expiry (e.g., 24h, 7d, 30d)
JWT_EXPIRY=7d

# Database path (relative to project root)
DB_PATH=./data/nexuspanel.db

# Health check default interval in seconds
HEALTH_CHECK_INTERVAL=60

# Rate limit: max login attempts per window
RATE_LIMIT_MAX=5

# Rate limit: window duration in minutes
RATE_LIMIT_WINDOW=15

# Enable demo data seeding on first run (true | false)
SEED_DEMO_DATA=false
