<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- 1. Ulubione Aplikacje Widget (Favorite Apps - Max 4) -->
        <receiver
            android:name=".FavoriteAppsWidget"
            android:exported="true"
            android:label="NexusPanel · Ulubione Aplikacje">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_favorite_apps_info" />
        </receiver>

        <!-- 2. Status Serwera Widget (CPU, RAM, Temp, Uptime) -->
        <receiver
            android:name=".ServerStatusWidget"
            android:exported="true"
            android:label="NexusPanel · Status Serwera">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_server_status_info" />
        </receiver>

        <!-- 3. Status Usług Widget (Online, Warning, Offline) -->
        <receiver
            android:name=".ServicesStatusWidget"
            android:exported="true"
            android:label="NexusPanel · Status Usług">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_services_status_info" />
        </receiver>

        <!-- 4. Uptime Widget (24h, 7d, 30d) -->
        <receiver
            android:name=".UptimeWidget"
            android:exported="true"
            android:label="NexusPanel · Uptime">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_uptime_info" />
        </receiver>

        <!-- 5. Monitoring Konkretnej Usługi Widget (Single Service Monitor) -->
        <receiver
            android:name=".SingleServiceWidget"
            android:exported="true"
            android:label="NexusPanel · Monitoring Usługi">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_single_service_info" />
        </receiver>

        <!-- 6. Nexus Overview Widget (Master Overview Card) -->
        <receiver
            android:name=".NexusOverviewWidget"
            android:exported="true"
            android:label="NexusPanel · Nexus Overview">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_nexus_overview_info" />
        </receiver>
    </application>
</manifest>
