<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_fav_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_compact"
    android:padding="8dp">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/widget_status_online"
            android:layout_marginEnd="5dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NexusPanel"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=" · Ulubione"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_fav_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4/4 Online"
            android:textColor="#34D399"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/widget_button_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- 2x2 Grid of 4 Favorite Apps (With IP & Status) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Row 1: App 1 & App 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <!-- App 1 -->
            <LinearLayout
                android:id="@+id/widget_fav_card_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_chip_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginEnd="2dp">

                <ImageView
                    android:id="@+id/widget_fav_icon_1"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:scaleType="centerInside" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:id="@+id/widget_fav_name_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Proxmox"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/widget_fav_ip_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="192.168.10.96"
                        android:textColor="#CBD5E1"
                        android:textSize="10.5sp"
                        android:fontFamily="monospace"
                        android:layout_marginTop="1dp"
                        android:singleLine="true" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_fav_status_1"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:src="@drawable/widget_status_online" />
            </LinearLayout>

            <!-- App 2 -->
            <LinearLayout
                android:id="@+id/widget_fav_card_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_chip_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginStart="2dp">

                <ImageView
                    android:id="@+id/widget_fav_icon_2"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:scaleType="centerInside" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:id="@+id/widget_fav_name_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ASUSTOR NAS"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/widget_fav_ip_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="192.168.10.66"
                        android:textColor="#CBD5E1"
                        android:textSize="10.5sp"
                        android:fontFamily="monospace"
                        android:layout_marginTop="1dp"
                        android:singleLine="true" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_fav_status_2"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:src="@drawable/widget_status_online" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: App 3 & App 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- App 3 -->
            <LinearLayout
                android:id="@+id/widget_fav_card_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_chip_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginEnd="2dp">

                <ImageView
                    android:id="@+id/widget_fav_icon_3"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:scaleType="centerInside" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:id="@+id/widget_fav_name_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Immich"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/widget_fav_ip_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="192.168.10.70"
                        android:textColor="#CBD5E1"
                        android:textSize="10.5sp"
                        android:fontFamily="monospace"
                        android:layout_marginTop="1dp"
                        android:singleLine="true" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_fav_status_3"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:src="@drawable/widget_status_online" />
            </LinearLayout>

            <!-- App 4 -->
            <LinearLayout
                android:id="@+id/widget_fav_card_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_chip_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginStart="2dp">

                <ImageView
                    android:id="@+id/widget_fav_icon_4"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:scaleType="centerInside" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:id="@+id/widget_fav_name_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Umbrel OS"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/widget_fav_ip_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="192.168.10.70"
                        android:textColor="#CBD5E1"
                        android:textSize="10.5sp"
                        android:fontFamily="monospace"
                        android:layout_marginTop="1dp"
                        android:singleLine="true" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_fav_status_4"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:src="@drawable/widget_status_online" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
