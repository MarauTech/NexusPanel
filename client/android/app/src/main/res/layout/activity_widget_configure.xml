<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0F19"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/widget_status_online"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cfg_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Konfiguracja Widżetu"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cfg_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dostosuj dane wyświetlane na pulpicie telefonu"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/cfg_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/widget_bg_compact"
            android:padding="16dp">

            <!-- Dynamic content injected in Java -->
            <TextView
                android:id="@+id/cfg_loading_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pobieranie listy usług z Twojego serwera NexusPanel..."
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="20dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Save Button -->
    <Button
        android:id="@+id/cfg_btn_save"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Zapisz Widżet"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/widget_button_bg"
        android:layout_marginTop="16dp" />

</LinearLayout>
