<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_launcher_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NexusPanel · Ulubione Usługi"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:text="Szybki Start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#6366F1"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4 Quick Shortcut Tiles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Shortcut 1: Proxmox -->
        <LinearLayout
            android:id="@+id/widget_shortcut_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_item_bg"
            android:padding="6dp"
            android:layout_marginEnd="3dp"
            android:gravity="center">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/widget_status_online" />

            <TextView
                android:id="@+id/widget_app_1_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Proxmox"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Shortcut 2: Home Assistant -->
        <LinearLayout
            android:id="@+id/widget_shortcut_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_item_bg"
            android:padding="6dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:gravity="center">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/widget_status_online" />

            <TextView
                android:id="@+id/widget_app_2_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home Assist."
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Shortcut 3: AdGuard -->
        <LinearLayout
            android:id="@+id/widget_shortcut_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_item_bg"
            android:padding="6dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:gravity="center">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/widget_status_online" />

            <TextView
                android:id="@+id/widget_app_3_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AdGuard"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Shortcut 4: Jellyfin -->
        <LinearLayout
            android:id="@+id/widget_shortcut_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_item_bg"
            android:padding="6dp"
            android:layout_marginStart="3dp"
            android:gravity="center">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/widget_status_online" />

            <TextView
                android:id="@+id/widget_app_4_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jellyfin"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:singleLine="true" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
