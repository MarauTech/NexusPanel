<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_launcher_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_compact"
    android:padding="8dp">

    <!-- 1. Minimal Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/widget_status_online"
            android:layout_marginEnd="5dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NexusPanel"
            android:textColor="#94A3B8"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" · Ulubione"
            android:textColor="#F1F5F9"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_fav_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6/6 Online"
            android:textColor="#34D399"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:background="@drawable/widget_button_bg"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="1.5dp"
            android:paddingBottom="1.5dp" />
    </LinearLayout>

    <!-- 2. Dense 6-Item Grid (3 Rows x 2 Columns) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- ROW 1: Slot 1 & Slot 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <!-- Slot 1 -->
            <LinearLayout
                android:id="@+id/widget_shortcut_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_chip_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="2dp">

                <TextView
                    android:id="@+id/widget_tile_1_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/widget_icon_badge_indigo"
                    android:gravity="center"
                    android:text="PX"
                    android:textColor="#818CF8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:id="@+id/widget_app_1_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Proxmox"
                        android:textColor="#F1F5F9"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/widget_tile_1_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Infrastruktura"
                        android:textColor="#64748B"
                        android:textSize="8.5sp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_tile_1_status"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:src="@drawable/widget_status_online" />
            </LinearLayout>

            <!-- Slot 2 -->
            <LinearLayout
                android:id="@+id/widget_shortcut_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_chip_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginStart="2dp">

                <TextView
                    android:id="@+id/widget_tile_2_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/widget_icon_badge_indigo"
                    android:gravity="center"
                    android:text="HA"
                    android:textColor="#38BDF8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:id="@+id/widget_app_2_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home Assistant"
                        android:textColor="#F1F5F9"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/widget_tile_2_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Smart Home"
                        android:textColor="#64748B"
                        android:textSize="8.5sp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_tile_2_status"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:src="@drawable/widget_status_online" />
            </LinearLayout>
        </LinearLayout>

        <!-- ROW 2: Slot 3 & Slot 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <!-- Slot 3 -->
            <LinearLayout
                android:id="@+id/widget_shortcut_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_chip_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="2dp">

                <TextView
                    android:id="@+id/widget_tile_3_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/widget_icon_badge_indigo"
                    android:gravity="center"
                    android:text="AG"
                    android:textColor="#34D399"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:id="@+id/widget_app_3_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AdGuard Home"
                        android:textColor="#F1F5F9"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/widget_tile_3_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DNS &amp; Blokada"
                        android:textColor="#64748B"
                        android:textSize="8.5sp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_tile_3_status"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:src="@drawable/widget_status_online" />
            </LinearLayout>

            <!-- Slot 4 -->
            <LinearLayout
                android:id="@+id/widget_shortcut_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_chip_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginStart="2dp">

                <TextView
                    android:id="@+id/widget_tile_4_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/widget_icon_badge_indigo"
                    android:gravity="center"
                    android:text="JF"
                    android:textColor="#C084FC"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:id="@+id/widget_app_4_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jellyfin"
                        android:textColor="#F1F5F9"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/widget_tile_4_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Multimedia"
                        android:textColor="#64748B"
                        android:textSize="8.5sp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_tile_4_status"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:src="@drawable/widget_status_online" />
            </LinearLayout>
        </LinearLayout>

        <!-- ROW 3: Slot 5 & Slot 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Slot 5 -->
            <LinearLayout
                android:id="@+id/widget_shortcut_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_chip_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="2dp">

                <TextView
                    android:id="@+id/widget_tile_5_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/widget_icon_badge_indigo"
                    android:gravity="center"
                    android:text="PT"
                    android:textColor="#38BDF8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:id="@+id/widget_app_5_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Portainer"
                        android:textColor="#F1F5F9"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/widget_tile_5_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Docker &amp; Kontenery"
                        android:textColor="#64748B"
                        android:textSize="8.5sp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_tile_5_status"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:src="@drawable/widget_status_online" />
            </LinearLayout>

            <!-- Slot 6 -->
            <LinearLayout
                android:id="@+id/widget_shortcut_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_chip_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginStart="2dp">

                <TextView
                    android:id="@+id/widget_tile_6_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/widget_icon_badge_indigo"
                    android:gravity="center"
                    android:text="GF"
                    android:textColor="#F97316"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:id="@+id/widget_app_6_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grafana"
                        android:textColor="#F1F5F9"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/widget_tile_6_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Monitoring"
                        android:textColor="#64748B"
                        android:textSize="8.5sp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_tile_6_status"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:src="@drawable/widget_status_online" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
