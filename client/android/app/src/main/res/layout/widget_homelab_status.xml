<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- Header: Title, Status and Refresh Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/widget_status_online"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NexusPanel · Homelab"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_node_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PVE Online"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/widget_button_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginEnd="6dp" />

        <ImageButton
            android:id="@+id/widget_btn_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_item_bg"
            android:src="@android:drawable/ic_popup_sync"
            android:contentDescription="Odśwież" />
    </LinearLayout>

    <!-- Metrics Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- CPU Metric -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_item_bg"
            android:padding="8dp"
            android:layout_marginEnd="4dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CPU"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_cpu_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14%"
                android:textColor="#818CF8"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- RAM Metric -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_item_bg"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RAM"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_ram_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="42%"
                android:textColor="#34D399"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Services Metric -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_item_bg"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USŁUGI"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_services_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18/18"
                android:textColor="#10B981"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer updated time -->
    <TextView
        android:id="@+id/widget_updated_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aktualizacja: 15:45 · 2 ms"
        android:textColor="#64748B"
        android:textSize="9sp"
        android:gravity="center"
        android:layout_marginTop="6dp" />

</LinearLayout>
