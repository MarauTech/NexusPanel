<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_uptime_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_compact"
    android:padding="8dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UPTIME"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=" · Dostępność"
            android:textColor="#F1F5F9"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30 DNI"
            android:textColor="#34D399"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:background="@drawable/widget_button_bg"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp" />
    </LinearLayout>

    <!-- Main Big Percentage & Host Uptime -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/widget_uptime_big_percent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="99.98%"
            android:textColor="#34D399"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_uptime_host_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Host: 42d 6h"
            android:textColor="#94A3B8"
            android:textSize="9.5sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- 3 Breakdown Mini Columns (24h, 7d, 30d) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/widget_chip_bg"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24 GODZINY"
                android:textColor="#64748B"
                android:textSize="7.5sp" />

            <TextView
                android:id="@+id/widget_uptime_24h"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="99.98%"
                android:textColor="#34D399"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7 DNI"
                android:textColor="#64748B"
                android:textSize="7.5sp" />

            <TextView
                android:id="@+id/widget_uptime_7d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="99.95%"
                android:textColor="#34D399"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 DNI"
                android:textColor="#64748B"
                android:textSize="7.5sp" />

            <TextView
                android:id="@+id/widget_uptime_30d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="99.90%"
                android:textColor="#34D399"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
