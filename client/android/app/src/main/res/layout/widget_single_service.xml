<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_single_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_compact"
    android:padding="8dp">

    <!-- Top Card: Logo, Name, IP & Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_single_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_icon_badge_indigo"
            android:gravity="center"
            android:text="PL"
            android:textColor="#818CF8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/widget_single_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plex Media Server"
                android:textColor="#F1F5F9"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_single_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="192.168.10.20"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_single_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢 Online"
            android:textColor="#34D399"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:background="@drawable/widget_button_bg"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="1.5dp"
            android:paddingBottom="1.5dp" />
    </LinearLayout>

    <!-- Bottom Metric Chips (Uptime & Latency) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Uptime -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_chip_bg"
            android:layout_marginEnd="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UPTIME"
                android:textColor="#64748B"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/widget_single_uptime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14d 6h"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- Latency -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_chip_bg"
            android:layout_marginStart="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CZAS ODPOWIEDZI"
                android:textColor="#64748B"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/widget_single_latency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8 ms"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
